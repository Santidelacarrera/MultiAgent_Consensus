# ═══ Segundo Cerebro — variables del stack E2E ═══════════════════════════════════════════════════════════════
# Uso:   cp .env.example .env && ./scripts/gen_secrets.sh      (sustituye cada CHANGE_ME por un secreto aleatorio)
# `run_e2e_stack.sh` se niega a arrancar mientras quede algún CHANGE_ME. NO subas `.env` al repositorio.
# Las contraseñas de base de datos/Redis van incrustadas en URLs: sólo caracteres URL-safe (gen_secrets.sh los respeta).

# ── Perímetro ───────────────────────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080                       # único puerto publicado (127.0.0.1)
GUARD_SIGNING_KEY=CHANGE_ME             # HMAC del contexto firmado gateway→servicios (>=32 bytes)
GUARD_JWT_SECRET=CHANGE_ME              # HS256 para JWT de clientes (>=32 bytes)
GUARD_ADMIN_API_KEY=CHANGE_ME
GUARD_BLOCK_THRESHOLD=7

# ── Tenants de ejemplo (claves en claro SÓLO aquí; los servicios reciben hashes SHA-256 vía `secrets-init`) ──────
ACME_CLIENT_API_KEY=CHANGE_ME           # cliente del gateway
GLOBEX_CLIENT_API_KEY=CHANGE_ME
ACME_RAG_READER_KEY=CHANGE_ME           # consensus-service → ContextRAG (rol reader)
GLOBEX_RAG_READER_KEY=CHANGE_ME
ACME_RAG_ADMIN_KEY=CHANGE_ME            # ingesta/auditoría de ContextRAG (usada por el E2E para sembrar datos)
GLOBEX_RAG_ADMIN_KEY=CHANGE_ME

# ── PostgreSQL 16 ───────────────────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME             # superusuario: sólo inicialización, ningún servicio lo usa
CONTEXTRAG_OWNER_PASSWORD=CHANGE_ME     # rol propietario (DDL/particiones)
CONTEXTRAG_APP_PASSWORD=CHANGE_ME       # rol de aplicación: sin BYPASSRLS, sujeto a RLS
CLOUDCOST_OWNER_PASSWORD=CHANGE_ME
CLOUDCOST_APP_PASSWORD=CHANGE_ME
DOCMIND_DB_PASSWORD=CHANGE_ME

# ── Redis (ACL: un usuario por servicio, con prefijo de claves propio) ─────────────────────────────────────────
REDIS_PASSWORD_ADMIN=CHANGE_ME
REDIS_PASSWORD_CONTEXTRAG=CHANGE_ME
REDIS_PASSWORD_CONSENSUS=CHANGE_ME
REDIS_PASSWORD_DOCMIND=CHANGE_ME
REDIS_PASSWORD_CLOUDCOST=CHANGE_ME

# ── Secretos de aplicación ───────────────────────────────────────────────────────────────────────────────────
CONTEXTRAG_MASTER_KEY=CHANGE_ME         # cifrado en reposo del texto de los chunks (por tenant)
ORCHESTRATOR_TOKEN=CHANGE_ME            # acceso a la API de NexusFlow
DOWNSTREAM_TOKEN=CHANGE_ME              # NexusFlow → consensus-service (ruta interna /v1/consensus)
DOCMIND_JWT_SECRET=CHANGE_ME
DOCMIND_PII_MASKING_KEY=CHANGE_ME
CLOUDCOST_JWT_SECRET=CHANGE_ME
CLOUDCOST_AUTH_PEPPER=CHANGE_ME

# ── Ajustes (opcionales) ─────────────────────────────────────────────────────────────────────────────────────
CONTEXTRAG_RATE_LIMIT_PER_MIN=600
EMBEDDER=hashing                        # hashing (sin descargas) | bge (requiere extra `models` e Internet en build)
RERANKER=lexical
NLI=lexical
RAG_LLM=extractive
LOG_LEVEL=INFO
STRICT_CONTRACTS=false                  # true: las discrepancias de contrato conocidas hacen fallar el E2E

# ── Orígenes de construcción (repos hermanos; sustituye por rutas locales para construir sin red) ────────────────
# CONTEXTRAG_REF=claude/tender-cray-4zua6u      CONTEXTRAG_CONTEXT=../../ContextRAG_Engine
# SHADOWAPI_REF=claude/beautiful-goodall-u52sn1 SHADOWAPI_CONTEXT=../../ShadowAPI_Guard/edge-gateway
# NEXUSFLOW_REF=main
# DOCMIND_REF=claude/eager-planck-v6esv9
# CLOUDCOST_REF=claude/busy-clarke-hnv1on
