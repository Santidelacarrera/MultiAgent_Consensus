{
  "name": "multiagent-consensus",
  "version": "1.0.0",
  "description": "Orquestador de consenso multi-agente (BFT) para GitOps & Architecture PR gates",
  "private": true,
  "license": "MIT",
  "main": "dist/orchestrator/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/orchestrator/src/main.js",
    "start:dev": "ts-node orchestrator/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:py": "cd gatekeeper && python3 -m pytest -q",
    "demo": "ts-node orchestrator/src/demo/run_scenarios.ts",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.5",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
