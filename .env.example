# ── Secretos obligatorios ───────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
BUS_SECRET=change-me-long-random          # deriva las claves HMAC de cada agente
ORCHESTRATOR_API_KEY=change-me-too        # gatekeeper → orquestador

# ── GitHub ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=                             # PAT / App token: pull_requests:write, statuses:write, contents:read
GITHUB_WEBHOOK_SECRET=                    # el mismo que configures en el webhook (eventos: Pull requests, Issue comments)

# ── GitLab ──────────────────────────────────────────────────────────────
GITLAB_TOKEN=
GITLAB_WEBHOOK_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4

# ── Política ────────────────────────────────────────────────────────────
MAX_ROUNDS=3
VETO_ON_CRITICAL=true
MONTHLY_BUDGET_USD=1000                   # incremento de coste mensual que activa el hallazgo "high" de FinOps
GATEKEEPER_AUTO_MERGE=false
GATEKEEPER_REQUEST_CHANGES=false
GATEKEEPER_SENIOR_REVIEWERS=alice,bob     # vacío = cualquiera con permiso de escritura

# ── LLM opcional (none | claude | ollama) ───────────────────────────────
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1
